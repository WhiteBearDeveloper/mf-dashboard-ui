{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "#components/*": ["./src/components/*.tsx"],
      "#types/*": ["./src/types/*.ts"],
      "#utils/*": ["./src/utils/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
