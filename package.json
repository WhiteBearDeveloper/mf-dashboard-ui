{
  "name": "@whitebeardeveloper/ui",
  "version": "0.8.1",
  "description": "Reusable UI components for Dashboard",
  "imports": {
    "#types/*": "./src/types/*.ts",
    "#components/*": "./src/components/*.tsx",
    "#utils/*": "./src/utils/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "sass": "./src/styles/index.scss",
      "default": "./src/index.ts"
    },
    "./reset": {
      "sass": "./src/styles/_reset.scss"
    },
    "./fonts": {
      "sass": "./src/styles/fonts.scss"
    },
    "./fonts/inter-variable.woff2": "./src/assets/fonts/Inter/InterVariable.woff2"
  },
  "peerDependencies": {
    "@whitebeardeveloper/contracts": "^0.2.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "radix-ui": "^1.8.1",
    "react-calendar": "^6.0.1"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0"
  }
}
