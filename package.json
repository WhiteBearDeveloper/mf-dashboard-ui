{
  "name": "@whitebeardeveloper/ui",
  "version": "0.8.2",
  "description": "Reusable UI components for Dashboard",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-package-assets.mjs",
    "prepack": "npm run build"
  },
  "imports": {
    "#types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "#components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "#utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "sass": "./dist/styles/index.scss",
      "default": "./dist/index.js"
    },
    "./reset": {
      "sass": "./dist/styles/_reset.scss"
    },
    "./fonts": {
      "sass": "./dist/styles/fonts.scss"
    },
    "./fonts/inter-variable.woff2": "./dist/assets/fonts/Inter/InterVariable.woff2"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@whitebeardeveloper/contracts": "^0.2.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "radix-ui": "^1.8.1",
    "react-calendar": "^6.0.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
