{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#components/*": ["./src/components/*.tsx"],
      "#types/*": ["./src/types/*.ts"],
      "#utils/*": ["./src/utils/*.ts"]
    }
  },
  "include": ["src"]
}
